# Copy to `.env` locally, or set in GitHub repo Settings → Secrets → Actions
# (and reference in .github/workflows/deploy.yml). All vars need the
# VITE_ prefix — that's how Vite exposes them to the browser.

# ===== Google Analytics 4 (already wired) =====
# Get yours: https://analytics.google.com → create property → Web stream
# Format: G-XXXXXXXX
VITE_GA_ID=

# ===== Google AdSense (revenue) =====
# Get yours: https://adsense.google.com → Sites → Add Site → wait for approval
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Approval typically requires a live site with a few weeks of traffic.
# Leaving this empty disables ads completely (no script load, no cookies).
VITE_ADSENSE_CLIENT=

# ===== Google Maps Places (data — optional) =====
# Costs $: ~$32/1k searches; $200/mo free tier
# Without it, we use OSM + Refuge + Wikidata + city open-data + brand list.
# Get yours: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_KEY=
